# 파이참 - 파이썬 장고 이그노어

# 가상환경 차단
django-backend/plan_ai/
django-backend/venv/
django-backend/.venv/

# 파이썬 실행 관련 캐시 파일 차단
django-backend/**/__pycache__/
django-backend/**/*.py[cod]
django-backend/** barracks barracks/*$py.class

# 로컬 데이터베이스 및 환경 변수 (보안)
django-backend/db.sqlite3
django-backend/.env

# 개인 공부용 및 아키텍처 기록 파일
django-backend/*/projectArchitecture.txt
django-backend/**/account.txt


# vs코드 - 자바 스프링부트 이그노어

spring-backend/.gradle/
spring-backend/build/
spring-backend/out/
spring-backend/bin/


# IDE & OS 전체 프로젝트 공통 툴/시스템 파일 이그노어

# 파이참 및 VS Code 설정 폴더 전체 차단
.idea/
.vscode/

# OS 시스템 쓰레기 파일 차단
